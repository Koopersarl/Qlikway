{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SQL_SERVER;Database=YOUR_DATABASE;User Id=YOUR_USERNAME;Password=YOUR_PASSWORD;TrustServerCertificate=True;"
  },
  "FtpSettings": {
    "Server": "ftp://YOUR_FTP_SERVER",
    "Username": "YOUR_FTP_USERNAME",
    "Password": "YOUR_FTP_PASSWORD",
    "Path": "/csv"
  },
  "TempFolder": "temp",
  "ApiKey": "YOUR_SECRET_API_KEY_HERE",
  "AutoCreateTables": true,
  "SampleRowsForTypeDetection": 100
}
